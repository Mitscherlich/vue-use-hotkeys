{
  "name": "vue-use-hotkeys",
  "version": "1.0.0-beta.0",
  "description": "🎹 基于 hotkeys-js 的 Vue 3 Composition API 快捷键库",
  "type": "module",
  "author": "Mitscherlich Wei <mitscherlich36@gmail.com>",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "hotkeys",
    "keyboard",
    "shortcuts",
    "composable",
    "composition-api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build && vue-tsc",
    "check": "biome check --write",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "test": "vitest run"
  },
  "dependencies": {
    "hotkeys-js": "4.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@rsbuild/core": "~2.1.9",
    "@rslib/core": "^0.23.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^30.0.1",
    "rsbuild-plugin-unplugin-vue": "^0.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
